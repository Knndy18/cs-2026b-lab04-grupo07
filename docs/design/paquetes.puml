@startuml paquetes
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam nodesep 30
skinparam ranksep 40

skinparam PackageBackgroundColor #EEF2F8
skinparam PackageBorderColor #1A3A5C
skinparam ArrowColor #1A3A5C
skinparam ArrowThickness 1.2
skinparam NoteFontSize 10
skinparam NoteBackgroundColor #FFF9C4
skinparam NoteBorderColor #FBC02D

title San Camilo en Linea - Diagrama de Paquetes (ADR-001: Monolito Modular)

' -------------------------------------------------
' Capa 1: Presentacion / API
' -------------------------------------------------
package "api" as API <<Layer>> {
  package "api.rest" {
    [CatalogoController]
    [PedidosController]
    [PagosController]
    [EntregasController]
    [NotificacionesController]
  }
  package "api.auth" {
    [AuthFilter]
    [RoleGuard]
  }
}

' -------------------------------------------------
' Capa 2: Modulos de Aplicacion (Dominio)
' -------------------------------------------------
package "catalogo" as CAT <<Module>> {
  [ServicioCatalogo]
  [Producto]
  [Puesto]
  [RepositorioCatalogo <<port>>]
}

package "pedidos" as PED <<Module>> {
  [ServicioPedidos]
  [PedidoGlobal]
  [PedidoPuesto]
  [ItemPedido]
  [EstadoPedidoPuesto <<enum>>]
  [RepositorioPedidos <<port>>]
}

package "pagos" as PAG <<Module>> {
  [ServicioPagos]
  [Pago]
  [PasarelaPago <<port>>]
}

package "notificaciones" as NOT <<Module>> {
  [ServicioNotificaciones]
  [NotificadorWhatsApp <<port>>]
  [ColaMensajes]
}

package "entregas" as ENT <<Module>> {
  [ServicioEntregas]
  [Entrega]
  [RepositorioEntregas <<port>>]
}

' -------------------------------------------------
' Capa 3: Infraestructura (Adaptadores)
' -------------------------------------------------
package "infraestructura" as INF <<Layer>> {
  package "infraestructura.db" {
    [PostgresRepositorioPedidos]
    [PostgresRepositorioCatalogo]
    [PostgresRepositorioEntregas]
  }
  package "infraestructura.pagos" {
    [YapeAdapter]
  }
  package "infraestructura.mensajeria" {
    [WhatsAppAdapter]
  }
}

' -------------------------------------------------
' Relaciones claras de izquierda a derecha
' -------------------------------------------------
API --> CAT : usa
API --> PED : usa
API --> PAG : usa
API --> NOT : usa
API --> ENT : usa

PED --> CAT : stock
PED --> PAG : pago
PED --> NOT : notifica

CAT --> INF : implementa RepositorioCatalogo
PED --> INF : implementa RepositorioPedidos
PAG --> INF : implementa PasarelaPago
NOT --> INF : implementa NotificadorWhatsApp
ENT --> INF : implementa RepositorioEntregas

note bottom of API
  Capa de entrada:
  Controladores REST
  y filtros de seguridad.
end note

note bottom of PED
  Modulo propietario del
  ciclo de vida del pedido.
end note

note bottom of INF
  Inversion de dependencias (ADR-001):
  La infraestructura implementa los puertos.
  El dominio no conoce adaptadores externos.
  Grafo estrictamente aciclico.
end note

@enduml
