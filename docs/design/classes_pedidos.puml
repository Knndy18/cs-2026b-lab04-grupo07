@startuml classes_pedidos
top to bottom direction
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam classAttributeIconSize 0
skinparam nodesep 40
skinparam ranksep 45

skinparam class {
  BackgroundColor #F8FAFC
  BorderColor #1E293B
  ArrowColor #0F172A
}

set namespaceSeparator none

package "Entidades del Dominio" {
  class "Cliente" as pedidos.models.Cliente {
    id : UUID
    nombre : str
    celular : str
    direccion_delivery : Optional[str]
  }

  class "Puesto" as pedidos.models.Puesto {
    id : UUID
    numero_puesto : str
    nombre_comerciante : str
    celular_whatsapp : str
  }

  class "Producto" as pedidos.models.Producto {
    id : UUID
    nombre : str
    precio_unitario : Decimal
    stock_disponible : int
    liberar_stock(cantidad: int) -> None
    reservar_stock(cantidad: int) -> None
  }

  class "ItemPedido" as pedidos.models.ItemPedido {
    producto : Producto
    cantidad : int
    precio_unitario : Decimal
    calcular_subtotal() -> Decimal
  }

  enum "EstadoPedidoPuesto" as pedidos.models.EstadoPedidoPuesto {
    RECIBIDO
    LISTO
    RECOGIDO
    ENTREGADO
    RECHAZADO
  }

  class "PedidoPuesto" as pedidos.models.PedidoPuesto {
    id : UUID
    puesto : Puesto
    estado : EstadoPedidoPuesto
    items : List[ItemPedido]
    agregar_item(producto: Producto, cantidad: int) -> None
    calcular_subtotal() -> Decimal
    cambiar_estado(nuevo_estado: EstadoPedidoPuesto) -> None
  }

  class "Pago" as pedidos.models.Pago {
    id : UUID
    monto : Decimal
    codigo_referencia_yape : str
    aprobado : bool
  }

  class "PedidoGlobal" as pedidos.models.PedidoGlobal {
    id : UUID
    cliente : Cliente
    fecha_creacion : datetime
    pedidos_puesto : List[PedidoPuesto]
    pago : Optional[Pago]
    calcular_monto_total() -> Decimal
    confirmar() -> None
    cancelar(motivo: str) -> None
  }
}

package "Puertos (Interfaces)" {
  interface "PasarelaPago" as pedidos.models.PasarelaPago {
    verificar_pago(monto: Decimal, referencia: str) -> Pago
  }

  interface "RepositorioPedidos" as pedidos.models.RepositorioPedidos {
    guardar(pedido: PedidoGlobal) -> None
    buscar_por_id(pedido_id: uuid.UUID) -> Optional[PedidoGlobal]
  }

  interface "NotificadorWhatsApp" as pedidos.models.NotificadorWhatsApp {
    notificar_nuevo_pedido_comerciante(puesto: Puesto, pedido_puesto: PedidoPuesto) -> None
  }
}

package "Servicios de Aplicacion" {
  class "ServicioPedidos" as pedidos.models.ServicioPedidos {
    crear_pedido_multi_puesto(cliente: Cliente, items_por_puesto: List) -> PedidoGlobal
    procesar_pago_yape(pedido: PedidoGlobal, referencia: str) -> bool
  }
}

' Relaciones estructurales ordenadas
pedidos.models.PedidoGlobal --> pedidos.models.Cliente : cliente
pedidos.models.PedidoGlobal *-- pedidos.models.PedidoPuesto : pedidos_puesto
pedidos.models.PedidoGlobal o-- pedidos.models.Pago : pago

pedidos.models.PedidoPuesto --> pedidos.models.Puesto : puesto
pedidos.models.PedidoPuesto --> pedidos.models.EstadoPedidoPuesto : estado
pedidos.models.PedidoPuesto *-- pedidos.models.ItemPedido : items
pedidos.models.ItemPedido --> pedidos.models.Producto : producto

pedidos.models.ServicioPedidos ..> pedidos.models.RepositorioPedidos : usa
pedidos.models.ServicioPedidos ..> pedidos.models.PasarelaPago : usa
pedidos.models.ServicioPedidos ..> pedidos.models.NotificadorWhatsApp : usa
pedidos.models.ServicioPedidos ..> pedidos.models.PedidoGlobal : orquesta

@enduml
